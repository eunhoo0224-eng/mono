---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";
---

<Layout title={`페이지를 찾을 수 없어요 — ${site.name}`}>
  <section class="hero wrap">
    <span class="eyebrow">404</span>
    <h1>찾는 페이지가<br /><span class="accent">없어요.</span></h1>
    <p class="sub">주소가 바뀌었거나 사라진 페이지예요. 홈에서 다시 시작해 보세요.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">홈으로</a>
      <a class="btn btn-ghost" href="/work">작업 보러가기</a>
    </div>
  </section>
</Layout>
