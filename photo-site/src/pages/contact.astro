---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";
---

<Layout title={`연락 — ${site.name}`}>
  <div class="wrap editorial two-col">
    <div>
      <span class="eyebrow">연락</span>
      <h1>같이<br />찍어요.</h1>
      <a class="btn btn-primary" href={`mailto:${site.email}`}>이메일 보내기</a>
    </div>
    <div>
      <p class="lede">의뢰·협업·프린트 문의를 환영합니다.</p>
      <div class="contact-card">
        <ul class="contact-list">
          <li>
            <span class="k">이메일</span>
            <span class="v"><a href={`mailto:${site.email}`}>{site.email}</a></span>
          </li>
          <li>
            <span class="k">인스타그램</span>
            <span class="v">
              <a href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle}</a>
            </span>
          </li>
          <li>
            <span class="k">활동 지역</span>
            <span class="v">{site.location}</span>
          </li>
        </ul>
      </div>
      <p class="placeholder-note">
        자리 표시자 연락처입니다. src/lib/site.ts에서 실제 이메일·SNS로 바꾸세요.
      </p>
    </div>
  </div>
</Layout>
