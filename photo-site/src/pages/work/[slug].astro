---
import Layout from "../../layouts/Layout.astro";
import { getPublishedShoots } from "../../lib/shoots";
import { site } from "../../lib/site";

export function getStaticPaths() {
  const shoots = getPublishedShoots();
  return shoots.map((shoot, i) => {
    const next = shoots[(i + 1) % shoots.length];
    return {
      params: { slug: shoot.slug },
      props: { shoot, next },
    };
  });
}

const { shoot, next } = Astro.props;
const title = shoot.titleKo || shoot.titleEn || shoot.slug;
const nextTitle = next.titleKo || next.titleEn || next.slug;
---

<Layout title={`${title} — ${site.name}`} description={`${title} · ${shoot.place}`}>
  <div class="wrap">
    <header class="detail-head">
      <a class="back" href="/work">← 작업 목록</a>
      <h1>{title}</h1>
      <div class="detail-meta">
        <span class="m">{shoot.date}</span>
        <span class="m">{shoot.place}</span>
        {shoot.tags.map((t) => <span class="m tag">{t}</span>)}
      </div>
    </header>

    <div class="image-stack">
      {shoot.images.map((src) => <img src={src} alt={title} loading="lazy" />)}
    </div>

    <nav class="detail-nav">
      <a href="/work">← 전체 작업</a>
      <a href={`/work/${next.slug}`}>다음: {nextTitle} →</a>
    </nav>
  </div>
</Layout>
