---
import Layout from "../layouts/Layout.astro";
import ShootCard from "../components/ShootCard.astro";
import { getPublishedShoots } from "../lib/shoots";
import { site } from "../lib/site";

const shoots = getPublishedShoots();
const hero = shoots[0];
const rest = shoots.slice(1, 7);
---

<Layout title={`${site.name} — ${site.role}`}>
  <section class="hero wrap">
    <span class="eyebrow">{site.role} · {site.location}</span>
    <h1>
      빛을 기다렸다가,<br />
      <span class="accent">사람이 남긴 자리</span>를 찍습니다.
    </h1>
    <p class="sub">{site.heroSub}</p>
    <div class="actions">
      <a class="btn btn-primary" href="/work">작업 보러가기</a>
      <a class="btn btn-ghost" href="/contact">문의하기</a>
    </div>

    {
      hero && (
        <div class="hero-figure">
          <img src={hero.images[0]} alt={hero.titleKo || hero.titleEn} />
        </div>
      )
    }
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>대표 작업</h2>
      <p>의뢰받은 순간과, 아무도 기다리지 않은 순간을 함께 모았습니다.</p>
    </div>

    {
      shoots.length > 0 ? (
        <div class="work-grid">
          {hero && <ShootCard shoot={hero} feature />}
          {rest.map((s) => (
            <ShootCard shoot={s} />
          ))}
        </div>
      ) : (
        <p class="placeholder-note">
          아직 공개된 촬영 건이 없습니다. content/index.csv에 status=published인 행을 추가하세요.
        </p>
      )
    }
  </section>
</Layout>
