---
import Layout from "../layouts/Layout.astro";
import ShootCard from "../components/ShootCard.astro";
import { getPublishedShoots } from "../lib/shoots";
import { site } from "../lib/site";

const shoots = getPublishedShoots();
const hero = shoots[0];
const rest = shoots.slice(1, 7);
const total = String(shoots.length).padStart(2, "0");
---

<Layout title={`${site.name} — ${site.role}`} fullBleed>
  {
    hero && (
      <section class="hero">
        <img class="hero-img" src={hero.images[0]} alt={hero.titleKo || hero.titleEn} />
        <div class="hero-content">
          <div class="wrap">
            <p class="label">{site.role} — {site.location}</p>
            <h1 class="hero-title">{site.name}</h1>
            <p class="hero-sub">{site.heroSub}</p>
          </div>
        </div>
        <div class="scroll-cue">
          <span></span>
          Scroll
        </div>
      </section>
    )
  }

  <section class="section wrap">
    <div class="section-head">
      <h2>Selected Work</h2>
      <span class="count">{total} Projects</span>
    </div>

    {
      shoots.length > 0 ? (
        <div class="work-grid">
          {hero && <ShootCard shoot={hero} index={1} feature />}
          {rest.map((s, i) => (
            <ShootCard shoot={s} index={i + 2} />
          ))}
        </div>
      ) : (
        <p class="placeholder-note">
          아직 공개된 촬영 건이 없다. content/index.csv에 status=published인 행을 추가하라.
        </p>
      )
    }
  </section>
</Layout>
