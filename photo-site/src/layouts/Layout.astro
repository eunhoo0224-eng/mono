---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "사진 포트폴리오" } = Astro.props;
const path = Astro.url.pathname;

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">사진가 이름</a>
        <nav class="site-nav">
          <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>Home</a>
          <a href="/work" aria-current={isCurrent("/work") ? "page" : undefined}>Work</a>
          <a href="/about" aria-current={isCurrent("/about") ? "page" : undefined}>About</a>
          <a href="/contact" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} 사진가 이름. All rights reserved.</div>
    </footer>
  </body>
</html>
