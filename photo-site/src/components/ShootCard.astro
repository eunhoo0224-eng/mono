---
import type { Shoot } from "../lib/shoots";

interface Props {
  shoot: Shoot;
  feature?: boolean;
}

const { shoot, feature = false } = Astro.props;
const title = shoot.titleKo || shoot.titleEn || shoot.slug;
const year = shoot.date?.slice(0, 4);
const badges = shoot.tags.slice(0, 3);
---

<a class={`shoot-card${feature ? " feature" : ""}`} href={`/work/${shoot.slug}`}>
  <figure>
    <img src={shoot.images[0]} alt={title} loading="lazy" />
  </figure>
  <figcaption>
    {
      badges.length > 0 && (
        <div class="card-badges">
          {badges.map((b) => (
            <span class="badge">{b}</span>
          ))}
        </div>
      )
    }
    <h3 class="card-title">{title}</h3>
    <p class="card-meta">{year} · {shoot.place}</p>
  </figcaption>
</a>
