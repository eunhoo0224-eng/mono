# ── 대화 연습 웹앱 환경 변수 ──────────────────────────────────────────
# 이 파일을 .env.local 로 복사해서 채운다. 키는 절대 클라이언트로 안 나간다
# (모든 호출은 서버 라우트 경유). — 명세 5절 "API 키 관리"

# ── 프로바이더 선택 ───────────────────────────────────────────────
# 대화 LLM (페르소나 연기). 아첨 억제·지시 준수가 중요 → claude 권장
CONVERSATION_PROVIDER=claude          # claude | openai
# 아첨 판정용 경량 LLM (9절 ⑤ 2차 게이트)
JUDGE_PROVIDER=claude                 # claude | openai
# 지표 분석 LLM. 대화 LLM과 "다른 벤더"로 두는 것을 권장 (8절 주의: 자기 채점 금지)
ANALYSIS_PROVIDER=openai              # openai | claude
# STT
STT_PROVIDER=openai                   # openai | local | none(클라이언트 Web Speech 폴백)
# TTS
TTS_PROVIDER=openai                   # openai | elevenlabs | none(클라이언트 SpeechSynthesis 폴백)

# ── API 키 ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── 모델 ID (필요시 조정) ─────────────────────────────────────────
CLAUDE_CONVERSATION_MODEL=claude-sonnet-5
CLAUDE_JUDGE_MODEL=claude-haiku-4-5-20251001
OPENAI_CONVERSATION_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── 로컬 whisper (STT_PROVIDER=local 일 때) ───────────────────────
# 의뢰인의 mlx-whisper 파이프라인을 HTTP로 노출한 엔드포인트.
# POST multipart(file) → { "text": "..." } 를 반환하면 된다.
LOCAL_STT_URL=http://127.0.0.1:8123/transcribe

# ── ElevenLabs 보이스 (TTS_PROVIDER=elevenlabs 일 때) ─────────────
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
